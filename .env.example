# =================================================================
# YouTube Automation Agent - Environment Configuration Template
# =================================================================
# Copy this file to .env and fill in your keys.
# 
# Detailed Setup Guide: https://github.com/yourusername/ytagent/blob/main/API_KEYS_SETUP.md

# -----------------------------------------------------------------
# 1. CORE AI BRAIN (Required)
# -----------------------------------------------------------------
# Get your Gemini API Key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------
# 2. VISUALS & MEDIA (Required)
# -----------------------------------------------------------------
# Pexels (Stock Video): https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# YouTube Data API v3 Key: https://console.cloud.google.com/
# (Required for trend analysis and search)
YOUTUBE_API_KEY=your_youtube_api_key_here

# -----------------------------------------------------------------
# 3. GOOGLE CLOUD & YOUTUBE UPLOADS (Required for Automation)
# -----------------------------------------------------------------
# Project ID from Google Cloud Console
GOOGLE_CLOUD_PROJECT=your-project-id

# Path to your service account key or client secrets
# Default is 'service-account-key.json' or 'client_secrets.json' in root
GOOGLE_APPLICATION_CREDENTIALS=service-account-key.json

# -----------------------------------------------------------------
# 4. ENHANCEMENTS (Optional)
# -----------------------------------------------------------------
# Hugging Face (AI Images): https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_hugging_face_token_here

# Pixabay (Sound Effects): https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_key_here

# Freesound (Alternate SFX): https://freesound.org/apiv2/apply
FREESOUND_API_KEY=your_freesound_key_here

# -----------------------------------------------------------------
# 5. AGENT SETTINGS
# -----------------------------------------------------------------
# Frequency in hours for automated checks/uploads
UPLOAD_FREQUENCY_HOURS=24

# Port for the Backend API (FastAPI)
BACKEND_PORT=8000
